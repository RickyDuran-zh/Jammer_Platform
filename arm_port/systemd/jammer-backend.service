[Unit]
Description=Jammer ARM backend (X310 sensing, decision, waveform, telemetry)
Documentation=file:/opt/zh_jammer_v4/arm_port/docs/03_deployment.md
After=network-online.target
Wants=network-online.target
# The RL service and the UI are separate units; the backend tolerates their absence
# (fallback action / dropped telemetry) so it must not depend on them.
Conflicts=jammer-backend@lab.service

[Service]
Type=simple
User=jammer
Group=jammer
EnvironmentFile=-/etc/jammer/jammer.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/zh_jammer_v4/arm_port
RuntimeDirectory=jammer
RuntimeDirectoryMode=0755
ExecStartPre=/bin/mkdir -p /run/jammer
ExecStart=/opt/zh_jammer_v4/arm_port/scripts/run_backend.sh
Restart=on-failure
RestartSec=3
# Keep the frame loop responsive: a dedicated CPU set is optional but helps on the
# little-core cluster.  Adjust to the cores that are free on the board.
#CPUAffinity=4 5 6 7
Nice=-5
LimitMEMLOCK=infinity
LimitNOFILE=65536
# Hard stop after the recovery ladder has had a chance to work.
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
