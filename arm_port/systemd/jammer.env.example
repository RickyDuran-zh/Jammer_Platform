# /etc/jammer/jammer.env  -- read by all three units.
#
# NEVER put secrets here.  The DeepSeek key stays in the OS keyring / is exported
# by the operator, exactly as documented in the main README.

# Paths
JAMMER_ROOT=/opt/zh_jammer_v4
JAMMER_PYTHON=/opt/zh_jammer_v4/arm_port/.venv/bin/python
JAMMER_CONFIG=/etc/jammer/jammer_arm.json
JAMMER_RADIO=uhd
JAMMER_EXTRA_ARGS=--status /run/jammer/status.json

# RL service
JAMMER_ALGO=ppo

# RF transmission interlock.
# Leave commented out.  Uncomment ONLY inside an authorized shielded enclosure or
# a sufficiently attenuated cabled test setup, and only for the test window.
#ZH_RF_TX_ENABLE=LAB_ONLY
